; Chicken Brawl — konfiguracja projektu (Godot 4.7)

config_version=5

[application]

config/name="Chicken Brawl"
config/description="Jesteś kurczakiem. Oni są ptakami."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
Art="*res://autoload/art.gd"
Audio="*res://autoload/audio.gd"
Fx="*res://autoload/fx.gd"
Flow="*res://autoload/flow.gd"
Net="*res://autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[layer_names]

2d_physics/layer_1="terrain"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="hitbox"
2d_physics/layer_5="hurtbox"
2d_physics/layer_6="pickup"
2d_physics/layer_7="platform"

[physics]

2d/default_gravity=1800.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.13, 1)
