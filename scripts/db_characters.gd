static func get_data(id: String) -> Dictionary:
	return LIST.get(id, LIST["kurczak"])

static func ordered_ids() -> Array:
	var out := []
	for id in LIST:
		out.append(id)
	out.sort_custom(func(a, b): return int(LIST[a]["order"]) < int(LIST[b]["order"]))
	return out

static func xp_for_level(level: int) -> int:
	return int(40.0 * pow(float(level), 1.5) + 60.0 * float(level))
